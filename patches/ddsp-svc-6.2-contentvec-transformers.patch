+class HubertModelWithFinalProj(HubertModel):
+    """跟正文 6.3 分支同款：HF HubertModel + final_proj，可直接吃转换后的 state_dict。"""
+
+    def __init__(self, config):
+        super().__init__(config)
+        self.final_proj = torch.nn.Linear(config.hidden_size, config.classifier_proj_size)
+
+
+def _load_hubert_state(path):
+    checkpoint = torch.load(path, map_location='cpu')
+    if isinstance(checkpoint, dict) and 'model' in checkpoint and not any(
+            str(k).startswith(('hubert.', 'encoder.')) for k in checkpoint):
+        checkpoint = checkpoint['model']
+    return checkpoint
+
